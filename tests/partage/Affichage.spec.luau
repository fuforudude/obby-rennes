-- Ce que l'interface affiche : formats de l'étape, du chrono, de l'aura, texte des panneaux du décor, écran d'arrivée.
return function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local Affichage = require(ReplicatedStorage.Partage.Affichage)

	describe("l'étape", function()
		it("s'écrit « étape/total »", function()
			expect(Affichage.etape(7, 15)).to.equal("7/15")
			expect(Affichage.etape(0, 15)).to.equal("0/15")
		end)
		it("reste dans les bornes", function()
			expect(Affichage.etape(-2, 15)).to.equal("0/15")
			expect(Affichage.etape(20, 15)).to.equal("15/15")
		end)
	end)

	describe("l'aura", function()
		it("sépare les milliers", function()
			expect(Affichage.aura(4200, 0, 10)).to.equal("4 200")
		end)
		it("n'affiche la série qu'à partir de ×2", function()
			expect(Affichage.aura(4200, 1, 10)).to.equal("4 200")
			expect(Affichage.aura(4200, 6, 10)).to.equal("4 200 ×6")
		end)
		it("plafonne la série", function()
			expect(Affichage.aura(100, 25, 10)).to.equal("100 ×10")
		end)
	end)

	describe("le chrono", function()
		it("compte depuis le début de la course", function()
			expect(Affichage.chrono(100, 183.456, nil)).to.equal("1:23.46")
		end)
		it("garde le dernier temps quand la course est finie", function()
			expect(Affichage.chrono(nil, 500, 61.5)).to.equal("1:01.50")
		end)
		it("vaut zéro avant le départ", function()
			expect(Affichage.chrono(nil, 500, nil)).to.equal("0:00.00")
		end)
	end)

	describe("le menu « Passer l'étape »", function()
		it("est caché tant que le produit n'existe pas", function()
			expect(Affichage.passerVisible(0, 3, 15)).to.equal(false)
		end)
		it("est visible avec un produit, avant l'arrivée", function()
			expect(Affichage.passerVisible(1234, 3, 15)).to.equal(true)
			expect(Affichage.passerVisible(1234, 15, 15)).to.equal(false)
		end)
	end)

	describe("le panneau d'anecdote", function()
		it("échappe le texte pour le texte enrichi", function()
			expect(Affichage.echapper("Rock & <roll> « ok »")).to.equal("Rock &amp; &lt;roll&gt; « ok »")
		end)
		it("met la zone en titre, puis l'anecdote, puis la vanne", function()
			local texte =
				Affichage.textePanneau({ numero = 3, zone = "Zone", anecdote = "Un fait.", blague = "Une vanne." })
			expect(texte).to.equal("<b>Zone</b>\n\nUn fait.\n\n<i>Une vanne.</i>")
		end)
	end)

	describe("l'écran d'arrivée", function()
		it("formate le temps, le gain et le record", function()
			local r = Affichage.arrivee(83.456, true, false, 1000, 80, 1000)
			expect(r.temps).to.equal("1:23.46")
			expect(r.gain).to.equal("+1 000")
			expect(r.record).to.equal("1:20.00")
			expect(r.nouveauRecord).to.equal(false)
			expect(r.nonClasse).to.equal(false)
			expect(r.sansChute).to.equal(false)
		end)
		it("reconnaît un parcours sans chute", function()
			expect(Affichage.arrivee(83, true, true, 6000, 83, 1000).sansChute).to.equal(true)
		end)
		it("signale un temps non classé, sans record", function()
			local r = Affichage.arrivee(83, false, false, 1000, 0, 1000)
			expect(r.nonClasse).to.equal(true)
			expect(r.record).to.equal(nil)
		end)
	end)
end
